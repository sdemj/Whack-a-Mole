false},{"en":"backpack","ko":"책가방","caseSensitive":false}]},{"name":"Household","words":[{"en":"door","ko":"문","caseSensitive":false},{"en":"window","ko":"창문","caseSensitive":false},{"en":"bed","ko":"침대","caseSensitive":false},{"en":"chair","ko":"의자","caseSensitive":false},{"en":"desk","ko":"책상","caseSensitive":false},{"en":"table","ko":"식탁","caseSensitive":false},{"en":"sofa","ko":"소파","caseSensitive":false},{"en":"clock","ko":"시계","caseSensitive":false},{"en":"lamp","ko":"램프","caseSensitive":false},{"en":"fan","ko":"선풍기","caseSensitive":false},{"en":"mirror","ko":"거울","caseSensitive":false},{"en":"sink","ko":"싱크대","caseSensitive":false},{"en":"stair","ko":"계단","caseSensitive":false},{"en":"towel","ko":"수건","caseSensitive":false},{"en":"toothbrush","ko":"칫솔","caseSensitive":false},{"en":"cup","ko":"컵","caseSensitive":false},{"en":"plate","ko":"접시","caseSensitive":false},{"en":"spoon","ko":"숟가락","caseSensitive":false},{"en":"fork","ko":"포크","caseSensitive":false},{"en":"box","ko":"상자","caseSensitive":false},{"en":"key","ko":"열쇠","caseSensitive":false},{"en":"phone","ko":"전화기","caseSensitive":false},{"en":"doll","ko":"인형","caseSensitive":false},{"en":"robot","ko":"로봇","caseSensitive":false},{"en":"umbrella","ko":"우산","caseSensitive":false},{"en":"present","ko":"선물","caseSensitive":false},{"en":"guitar","ko":"기타","caseSensitive":false},{"en":"basket","ko":"바구니","caseSensitive":false}]},{"name":"Clothing","words":[{"en":"cap","ko":"야구모자","caseSensitive":false},{"en":"hat","ko":"모자","caseSensitive":false},{"en":"coat","ko":"코트","caseSensitive":false},{"en":"jacket","ko":"재킷","caseSensitive":false},{"en":"shirt","ko":"셔츠","caseSensitive":false},{"en":"T-shirt","ko":"티셔츠","caseSensitive":true},{"en":"sweater","ko":"스웨터","caseSensitive":false},{"en":"dress","ko":"원피스","caseSensitive":false},{"en":"skirt","ko":"치마","caseSensitive":false},{"en":"pants","ko":"바지","caseSensitive":false},{"en":"hairpin","ko":"머리핀","caseSensitive":false},{"en":"socks","ko":"양말","caseSensitive":f