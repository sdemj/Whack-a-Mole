:"kick","ko":"차다","caseSensitive":false},{"en":"throw","ko":"던지다","caseSensitive":false},{"en":"climb","ko":"오르다","caseSensitive":false},{"en":"push","ko":"밀다","caseSensitive":false},{"en":"pull","ko":"당기다","caseSensitive":false},{"en":"turn","ko":"돌다","caseSensitive":false},{"en":"stop","ko":"멈추다","caseSensitive":false},{"en":"exercise","ko":"운동하다","caseSensitive":false},{"en":"pick","ko":"고르다","caseSensitive":false},{"en":"touch","ko":"만지다","caseSensitive":false},{"en":"grow","ko":"자라다","caseSensitive":false}]},{"name":"Talk&Feel","words":[{"en":"talk","ko":"이야기하다","caseSensitive":false},{"en":"say","ko":"말하다","caseSensitive":false},{"en":"tell","ko":"알려주다","caseSensitive":false},{"en":"ask","ko":"묻다","caseSensitive":false},{"en":"answer","ko":"대답하다","caseSensitive":false},{"en":"call","ko":"부르다","caseSensitive":false},{"en":"listen","ko":"듣다","caseSensitive":false},{"en":"sing","ko":"노래하다","caseSensitive":false},{"en":"meet","ko":"만나다","caseSensitive":false},{"en":"visit","ko":"방문하다","caseSensitive":false},{"en":"give","ko":"주다","caseSensitive":false},{"en":"thank","ko":"고마워하다","caseSensitive":false},{"en":"welcome","ko":"환영하다","caseSensitive":false},{"en":"like","ko":"좋아하다","caseSensitive":false},{"en":"want","ko":"원하다","caseSensitive":false},{"en":"know","ko":"알다","caseSensitive":false},{"en":"think","ko":"생각하다","caseSensitive":false},{"en":"love","ko":"사랑하다","caseSensitive":false},{"en":"see","ko":"보이다","caseSensitive":false},{"en":"look","ko":"바라보다","caseSensitive":false},{"en":"smile","ko":"미소짓다","caseSensitive":false},{"en":"cry","ko":"울다","caseSensitive":false},{"en":"laugh","ko":"소리내어 웃다","caseSensitive":false}]}]},{"ko":"특징과 감정","en":"Character&Feeling","subcategories":[{"name":"Look","words":[{"en":"big","ko":"큰","caseSensitive":false},{"en":"small","ko":"작은","caseSensitive":false},{"en":"large","ko":"커다란","caseSensitive":false},{"en":"tall","ko":"키가 큰","caseSensitive":false},{"en":"short","ko":"짧은·키가 작은","caseSensitive":false},{"en":"long","ko":"긴","caseSensitive":false},{"en":"slim","ko":"날씬한","caseSensitive":false},{"en":"fat","ko":"뚱뚱한","caseSensitive":false},{"en":"thin","ko":"얇은","caseSensitive":false},{"en":"heavy","ko":"무거운","caseSensitive":false},{"en":"light","ko":"가벼운","caseSensitive":false},{"en":"strong","ko":"힘이 센","caseSensitive":false},{"en":"weak","ko":"약한","caseSensitive":false},{"en":"straight","ko":"곧은","caseSensitive":false},{"en":"curly","ko":"곱슬한","caseSensitive":false},{"en":"pretty","ko":"예쁜","caseSensitive":false},{"en":"cute","ko":"귀여운","caseSensitive":false},{"en":"beautiful","ko":"아름다운","caseSensitive":false},{"en":"young","ko":"어린","caseSensitive":false},{"en":"old","ko":"나이가 많은","caseSensitive":false}]},{"name":"Character","words":[{"en":"good","ko":"착한","caseSensitive":false},{"en":"bad","ko":"나쁜","caseSensitive":false},{"en":"kind","ko":"친절한","caseSensitive":false},{"en":"nice","ko":"좋은","caseSensitive":false},{"en":"brave","ko":"용감한","caseSensitive":false},{"en":"funny","ko":"재미있는","caseSensitive":false},{"en":"smart","ko":"똑똑한","caseSensitive":false},{"en":"quiet","ko":"조용한","caseSensitive":false},{"en":"honest","ko":"정직한","caseSensitive":false},{"en":"lazy","ko":"게으른","caseSensitive":false}]},{"name":"Feeling","words":[{"en":"happy","ko":"행복한","caseSensitive":false},{"en":"sad","ko":"슬픈","caseSensitive":false},{"en":"angry","ko":"화난","caseSensitive":false},{"en":"glad","ko":"기쁜","caseSensitive":false},{"en":"excited","ko":"신난","caseSensitive":false},{"en":"afraid","ko":"두려운","caseSensitive":false},{"en":"tired","ko":"피곤한","caseSensitive":false},{"en":"sleepy","ko":"졸린","caseSensitive":false},{"en":"hungry","ko":"배고픈","caseSensitive":false},{"en":"thirsty","ko":"목마른","caseSensitive":false},{"en":"sick","ko":"아픈","caseSensitive":false},{"en":"busy","ko":"바쁜","caseSensitive":false},{"en":"surprised","ko":"놀란","caseSensitive":false}]}]}];
const CATEGORY_ICONS = ["🔢","🐾","🎨","🍎","🌦️","🚗","🎒","🏃","😊"];
const DIFFICULTIES = {
  easy:{label:"쉬움",exposure:7000},
  normal:{label:"보통",exposure:5000},
  hard:{label:"어려움",exposure:3000}
};
const BASE_TIME = 60;
const TOTAL_ROUNDS = 10;

const state = {
  screen:"intro",
  categoryIndex:null,
  selectedSubs:new Set(),
  mode:"word",
  difficulty:"normal",
  questions:[],
  results:[],
  currentIndex:0,
  score:0,
  streak:0,
  maxStreak:0,
  currentWrongHits:0,
  timeLeft:BASE_TIME,
  elapsed:0,
  bonusTime:0,
  wrongHitCount:0,
  paused:false,
  lock:false,
  gameActive:false,
  cycleTimer:null,
  timerId:null,
  lastTick:0,
  options:[],
  sfxOn:true,
  bgmOn:true,
  resumeAfterHelp:false
};

const $ = (sel, root=document) => root.querySelector(sel);
const $$ = (sel, root=document) => [...root.querySelectorAll(sel)];
const screens = {
  intro:$("#introScreen"), category:$("#categoryScreen"), sub:$("#subScreen"),
  settings:$("#settingsScreen"), game:$("#gameScreen"), result:$("#resultScreen")
};

function showScreen(name){
  Object.values(screens).forEach(s=>s.classList.remove("active"));
  screens[name].classList.add("active");
  state.screen=name;
  window.scrollTo(0,0);
  syncAudioButtons();
}
function shuffle(arr){
  const a=[...arr];
  for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}
  return a;
}
function sample(arr,n){return shuffle(arr).slice(0,n)}
function escapeHtml(text){
  return String(text).replace(/[&<>"']/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"}[c]));
}
function totalLibraryCount(){
  return WORD_BANK.reduce((sum,c)=>sum+c.subcategories.reduce((s,sub)=>s+sub.words.length,0),0);
}
function selectedPool(){
  const cat=WORD_BANK[state.categoryIndex];
  if(!cat)return[];
  const pool=[];
  cat.subcategories.forEach((sub,i)=>{
    if(state.selectedSubs.has(i)){
      sub.words.forEach(w=>pool.push({...w,subcategory:sub.name,category:cat.ko}));
    }
  });
  return pool;
}
function playSfx(kind){
  if(!state.sfxOn)return;
  const el = kind==="correct"?$("#correctSfx"):kind==="wrong"?$("#wrongSfx"):$("#completeSfx");
  try{el.currentTime=0;el.play().catch(()=>{})}catch(e){}
}
function ensureBgm(){
  if(!state.bgmOn)return;
  const a=$("#bgmAudio");if(!a)return;
  a.volume=0.35;
  a.play().catch(()=>{});
}
function stopBgm(){
  const a=$("#bgmAudio");if(!a)return;
  a.pause();
}
function toggleBgm(){
  const a=$("#bgmAudio");
  if(a&&a.paused){state.bgmOn=true;ensureBgm()}else{state.bgmOn=false;stopBgm()}
  syncAudioButtons();
}
document.addEventListener("click",()=>{if(state.bgmOn)ensureBgm()},{once:true});
document.addEventListener("keyup",()=>{if(state.bgmOn)ensureBgm()},{once:true});
document.addEventListener("visibilitychange",()=>{
  if(document.hidden)$("#bgmAudio")?.pause();
  else if(state.bgmOn)ensureBgm();
});
function toggleSfx(){
  state.sfxOn=!state.sfxOn;syncAudioButtons();
}
function syncAudioButtons(){
  $$(".bgm-toggle").forEach(b=>{b.textContent=state.bgmOn?"🎵 ON":"🎵 OFF";b.dataset.mobileIcon=state.bgmOn?"🎵":"🚫"});
  $("#introBgmBtn").textContent=state.bgmOn?"🎵":"🚫";
  $("#gameBgmBtn").textContent=state.bgmOn?"🎵 ON":"🎵 OFF";
  $("#gameBgmBtn").dataset.mobileIcon=state.bgmOn?"🎵":"🚫";
  $("#gameFxBtn").textContent=state.sfxOn?"🔊 효과음":"🔇 효과음";
  $("#gameFxBtn").dataset.mobileIcon=state.sfxOn?"🔊":"🔇";
}
function showToast(text,type="good",duration=900){
  const toast=document.createElement("div");
  toast.className=`toast ${type}`;
  toast.textContent=text;
  $("#toastLayer").appendChild(toast);
  requestAnimationFrame(()=>toast.classList.add("show"));
  setTimeout(()=>{toast.classList.remove("show");setTimeout(()=>toast.remove(),250)},duration);
}
function renderCategories(){
  const grid=$("#categoryGrid");grid.innerHTML="";
  WORD_BANK.forEach((cat,i)=>{
    const count=cat.subcategories.reduce((s,x)=>s+x.words.length,0);
    const b=document.createElement("button");
    b.className="category-card";
    b.innerHTML=`<span class="category-icon">${CATEGORY_ICONS[i]}</span>
      <span class="category-ko">${escapeHtml(cat.ko)}</span>
      <span class="category-en">${escapeHtml(cat.en)}</span>
      <span class="count-pill">${count}개 단어</span>`;
    b.addEventListener("click",()=>{
      ensureBgm();
      state.categoryIndex=i;state.selectedSubs=new Set();
      renderSubcategories();showScreen("sub");
    });
    grid.appendChild(b);
  });
  $("#libraryCount").textContent=totalLibraryCount();
}
function renderSubcategories(){
  const cat=WORD_BANK[state.categoryIndex];
  const grid=$("#subGrid");grid.innerHTML="";
  cat.subcategories.forEach((sub,i)=>{
    const b=document.createElement("button");
    b.className="sub-card"+(state.selectedSubs.has(i)?" selected":"");
    b.dataset.subIndex=String(i);
    b.innerHTML=`<span class="sub-check">${state.selectedSubs.has(i)?"✓":""}</span>
      <span class="sub-name">${escapeHtml(sub.name)}</span>
      <span class="count-pill">${sub.words.length}개 단어</span>`;
    b.addEventListener("mouseenter",()=>showWordPreview(b,sub));
    b.addEventListener("mousemove",()=>positionWordPreview(b));
    b.addEventListener("mouseleave",hideWordPreview);
    b.addEventListener("focus",()=>showWordPreview(b,sub));
    b.addEventListener("blur",hideWordPreview);
    b.addEventListener("click",()=>{
      hideWordPreview();
      if(state.selectedSubs.has(i))state.selectedSubs.delete(i);else state.selectedSubs.add(i);
      renderSubcategories();
    });
    grid.appendChild(b);
  });
  const count=selectedPool().length;
  const totalCount=cat.subcategories.reduce((n,s)=>n+s.words.length,0);
  const allSelected=state.selectedSubs.size===cat.subcategories.length;
  $("#selectionSummary").textContent=`소분류 ${state.selectedSubs.size}개 · 선택된 단어 ${count}개`;
  $("#toSettingsBtn").disabled=count<10;
  $("#selectAllBtn").textContent=`${allSelected?"전체 단어 선택 해제하기":"전체 단어 선택하기"} (${totalCount})`;
  $("#selectAllBtn").classList.toggle("selected",allSelected);
}
function updateSettingsSummary(){
  const pool=selectedPool();
  $("#settingsSummaryTitle").textContent=`${state.mode==="word"?"단어 익히기":"철자 익히기"} · ${DIFFICULTIES[state.difficulty].label}`;
  $("#settingsSummaryText").textContent=`${WORD_BANK[state.categoryIndex].ko} / 소분류 ${state.selectedSubs.size}개 / ${pool.length}개 단어 중 10문제`;
}
function setChoice(containerSelector,dataKey,value){
  $$(`${containerSelector} .choice-card`).forEach(b=>b.classList.toggle("selected",b.dataset[dataKey]===value));
}
function goHome(){
  if(state.gameActive && !confirm("진행 중인 게임을 끝내고 표지로 이동할까요?"))return;
  stopGameLoops();state.gameActive=false;closeSpellModal(false);closeHelp(false);showScreen("intro");
}
function openHelp(){
  state.resumeAfterHelp=state.gameActive && !state.paused;
  if(state.resumeAfterHelp)pauseGame();
  const onIntro=state.screen==="intro";
  $("#helpActions").innerHTML=onIntro?'<button id="helpStartBtn" class="primary-btn">GAME START ✨</button>':"";
  if(onIntro)$("#helpStartBtn").addEventListener("click",()=>{
    closeHelp(false);ensureBgm();renderCategories();showScreen("category");
  });
  $("#helpModal").classList.add("open");
}
function closeHelp(shouldResume=true){
  $("#helpModal").classList.remove("open");
  if(shouldResume && state.resumeAfterHelp && state.gameActive)resumeGame();
  state.resumeAfterHelp=false;
}
function createQuestions(){
  const pool=selectedPool();
  return sample(pool,Math.min(TOTAL_ROUNDS,pool.length));
}
function startGame(){
  ensureBgm();
  stopGameLoops();
  state.questions=createQuestions();
  state.results=state.questions.map(word=>({word,status:"pending",wrongHits:0,spellingBonus:false}));
  state.currentIndex=0;state.score=0;state.streak=0;state.maxStreak=0;state.currentWrongHits=0;
  state.timeLeft=BASE_TIME;state.elapsed=0;state.bonusTime=0;state.wrongHitCount=0;
  state.paused=false;state.lock=false;state.gameActive=true;state.lastTick=performance.now();
  showScreen("game");startTimer();renderQuestion();
}
function startTimer(){
  clearInterval(state.timerId);
  state.lastTick=performance.now();
  state.timerId=setInterval(()=>{
    if(!state.gameActive||state.paused){state.lastTick=performance.now();return}
    const now=performance.now();
    const delta=(now-state.lastTick)/1000;
    state.lastTick=now;
    state.timeLeft=Math.max(0,state.timeLeft-delta);
    state.elapsed+=delta;
    updateHud();
    if(state.timeLeft<=0)finishGame(false);
  },100);
}
function stopGameLoops(){
  if(state.cycleTimer){clearTimeout(state.cycleTimer);state.cycleTimer=null}
  if(state.timerId){clearInterval(state.timerId);state.timerId=null}
}
function pauseGame(){
  state.paused=true;
  if(state.cycleTimer){clearTimeout(state.cycleTimer);state.cycleTimer=null}
}
function resumeGame(){
  state.paused=false;state.lastTick=performance.now();
  if(state.gameActive)placeOptions();
}
function updateHud(){
  $("#roundStat").textContent=`${Math.min(state.currentIndex+1,TOTAL_ROUNDS)}/${TOTAL_ROUNDS}`;
  $("#scoreStat").textContent=state.score.toLocaleString();
  $("#streakStat").textContent=state.streak;
  $("#timeStat").textContent=state.timeLeft.toFixed(1);
  $("#timeStat").classList.toggle("timer-danger",state.timeLeft<=10);
  $("#progressBar").style.width=`${(state.currentIndex/TOTAL_ROUNDS)*100}%`;
}
function makeSpellingVariants(word,count=5){
  const variants=new Set();
  const alphabet="abcdefghijklmnopqrstuvwxyz";
  const add=v=>{if(v && v!==word && v.length>0)variants.add(v)};
  const idx=[...word].map((c,i)=>/[A-Za-z]/.test(c)?i:-1).filter(i=>i>=0);
  if(idx.length>=2){
    for(let k=0;k<idx.length-1;k++){
      const a=[...word],i=idx[k],j=idx[k+1];[a[i],a[j]]=[a[j],a[i]];add(a.join(""));
    }
  }
  idx.forEach(i=>add(word.slice(0,i)+word.slice(i+1)));
  idx.forEach(i=>{
    const ch=word[i];
    const repl=alphabet[(alphabet.indexOf(ch.toLowerCase())+7+Math.floor(Math.random()*10))%26];
    add(word.slice(0,i)+(ch===ch.toUpperCase()?repl.toUpperCase():repl)+word.slice(i+1));
  });
  idx.forEach(i=>add(word.slice(0,i)+word[i]+word.slice(i)));
  if(anyUpper(word))add(word.toLowerCase());else add(word[0]?word[0].toUpperCase()+word.slice(1):word);
  let guard=0;
  while(variants.size<count && guard<100){
    guard++;
    if(!idx.length){add(word+"x");continue}
    const i=idx[Math.floor(Math.random()*idx.length)];
    const repl=alphabet[Math.floor(Math.random()*alphabet.length)];
    add(word.slice(0,i)+repl+word.slice(i+1));
  }
  return sample([...variants],count);
}
function anyUpper(s){return /[A-Z]/.test(s)}
function buildOptions(word){
  if(state.mode==="spelling"){
    return shuffle([{text:word.en,correct:true},...makeSpellingVariants(word.en,5).map(text=>({text,correct:false}))]);
  }
  const pool=selectedPool().filter(w=>w.en!==word.en);
  const distractors=[];
  for(const w of shuffle(pool)){
    if(!distractors.some(d=>d.text===w.en)){distractors.push({text:w.en,correct:false})}
    if(distractors.length===5)break;
  }
  return shuffle([{text:word.en,correct:true},...distractors]);
}
function moleMarkup(option,index){
  return `<button class="mole-button" data-index="${index}" data-correct="${option.correct}" aria-label="${escapeHtml(option.text)}">
    <span class="mole">
      <span class="mole-art" aria-hidden="true"></span>
      <span class="word-board">${escapeHtml(option.text)}</span>
    </span>
  </button>`;
}
function renderQuestion(){
  if(!state.gameActive)return;
  if(state.currentIndex>=state.questions.length){finishGame(true);return}
  const word=state.questions[state.currentIndex];
  state.currentWrongHits=0;state.lock=false;
  $("#questionModeLabel").textContent=state.mode==="word"?"🔤 단어 익히기":"✍️ 철자 익히기";
  $("#questionWord").textContent=word.ko;
  $("#questionInstruction").textContent=state.mode==="word"?"뜻에 맞는 영어 단어를 잡으세요!":"철자가 정확한 영어 단어를 잡으세요!";
  state.options=buildOptions(word);
  updateHud();placeOptions();
}
function placeOptions(){
  if(!state.gameActive||state.paused)return;
  if(state.cycleTimer){clearTimeout(state.cycleTimer);state.cycleTimer=null}
  const grid=$("#moleGrid");
  const opts=shuffle(state.options);
  grid.innerHTML=opts.map((o,i)=>`<div class="hole">${moleMarkup(o,i)}</div>`).join("");
  $$(".mole-button",grid).forEach((b,i)=>{
    b.addEventListener("click",()=>hitMole(b,opts[i]));
  });
  requestAnimationFrame(()=>$$(".mole-button",grid).forEach((b,i)=>setTimeout(()=>b.classList.add("visible"),i*28)));
  state.cycleTimer=setTimeout(()=>{
    $$(".mole-button",grid).forEach(b=>{b.classList.remove("visible");b.classList.add("ducking")});
    state.cycleTimer=setTimeout(()=>{if(state.gameActive&&!state.paused&&!state.lock)placeOptions()},170);
  },DIFFICULTIES[state.difficulty].exposure);
}
function hitMole(button,option){
  if(state.lock||state.paused||!state.gameActive)return;
  state.lock=true;
  if(state.cycleTimer){clearTimeout(state.cycleTimer);state.cycleTimer=null}
  const result=state.results[state.currentIndex];
  if(option.correct){
    button.classList.add("correct");
    playSfx("correct");
    state.score+=100;
    state.streak++;
    state.maxStreak=Math.max(state.maxStreak,state.streak);
    result.status="correct";result.wrongHits=state.currentWrongHits;
    let bonusText="+100 정답!";
    if(state.streak%3===0){
      state.score+=50;state.timeLeft+=5;state.bonusTime+=5;
      bonusText="+100 정답 · 3연속 보너스 +50점, +5초!";
      showToast(bonusText,"bonus",1450);
    }else showToast(bonusText,"good",850);
    updateHud();
    if(state.mode==="spelling"){
      pauseGame();
      setTimeout(openSpellModal,430);
    }else{
      setTimeout(nextQuestion,620);
    }
  }else{
    button.classList.add("wrong");
    playSfx("wrong");
    state.score=Math.max(0,state.score-20);
    state.streak=0;state.currentWrongHits++;state.wrongHitCount++;
    showToast("-20 오답! 다시 찾아보세요.","bad",850);
    updateHud();
    setTimeout(()=>{state.lock=false;if(state.gameActive&&!state.paused)placeOptions()},520);
  }
}
function nextQuestion(){
  if(!state.gameActive)return;
  state.currentIndex++;
  $("#progressBar").style.width=`${(state.currentIndex/TOTAL_ROUNDS)*100}%`;
  if(state.currentIndex>=TOTAL_ROUNDS)finishGame(true);else renderQuestion();
}
function openSpellModal(){
  if(!state.gameActive)return;
  const word=state.questions[state.currentIndex];
  $("#spellKo").textContent=word.ko;
  $("#caseNotice").textContent=word.caseSensitive?"대소문자까지 정확하게 입력하세요.":"대소문자는 구분하지 않습니다.";
  $("#spellInput").value="";$("#spellFeedback").textContent="";
  $("#spellInput").classList.remove("error");
  $("#spellModal").classList.add("open");
  setTimeout(()=>$("#spellInput").focus(),80);
}
function closeSpellModal(resume=false){
  $("#spellModal").classList.remove("open");
  if(resume&&state.gameActive)resumeGame();
}
function submitSpelling(){
  const word=state.questions[state.currentIndex];
  if(!word)return;
  const raw=$("#spellInput").value.trim();
  const correct=word.caseSensitive?raw===word.en:raw.toLowerCase()===word.en.toLowerCase();
  if(correct){
    playSfx("correct");state.score+=50;state.results[state.currentIndex].spellingBonus=true;
    $("#spellFeedback").style.color="var(--good)";$("#spellFeedback").textContent="정확해요! +50점";
    showToast("철자 보너스 +50점!","bonus",900);updateHud();
    setTimeout(()=>{closeSpellModal(false);state.paused=false;state.lastTick=performance.now();nextQuestion()},650);
  }else{
    playSfx("wrong");
    $("#spellFeedback").style.color="var(--bad)";
    $("#spellFeedback").textContent="철자와 띄어쓰기, 대소문자를 다시 확인하세요.";
    const input=$("#spellInput");input.classList.remove("error");void input.offsetWidth;input.classList.add("error");input.select();
  }
}
function skipSpelling(){
  closeSpellModal(false);state.paused=false;state.lastTick=performance.now();nextQuestion();
}
function finishGame(completed){
  if(!state.gameActive)return;
  state.gameActive=false;stopGameLoops();state.paused=false;state.lock=true;
  closeSpellModal(false);
  $("#toastLayer").innerHTML="";
  playSfx("complete");
  renderResults(completed);showScreen("result");launchConfetti();
}
function renderResults(completed){
  const correct=state.results.filter(r=>r.status==="correct").length;
  $("#resultTitle").textContent=completed?"10문제 완료!":"시간 종료!";
  $("#resultMessage").textContent=completed
    ? `${WORD_BANK[state.categoryIndex].ko} 단어를 끝까지 연습했습니다.`
    : `${correct}문제를 해결했습니다. 남은 문제는 다음 도전에서 다시 만나 보세요.`;
  $("#finalScore").textContent=state.score.toLocaleString();
  $("#correctKpi").textContent=`${correct}/${TOTAL_ROUNDS}`;
  $("#timeKpi").textContent=`${state.elapsed.toFixed(1)}초`;
  $("#streakKpi").textContent=state.maxStreak;
  $("#bonusKpi").textContent=`+${state.bonusTime}초`;
  $("#answerList").innerHTML=state.results.map((r,i)=>{
    const ok=r.status==="correct";
    const meta=ok
      ? `${r.wrongHits?`오답 ${r.wrongHits}회 · `:""}${r.spellingBonus?"철자 +50":"완료"}`
      :"시간 내 미완료";
    return `<div class="answer-row ${ok?"ok":"pending"}">
      <div class="answer-mark">${ok?"○":"×"}</div>
      <div class="answer-word"><strong>${i+1}. ${escapeHtml(r.word.en)}</strong><small>${escapeHtml(r.word.ko)} · ${escapeHtml(r.word.subcategory)}</small></div>
      <div class="answer-meta">${meta}</div>
    </div>`;
  }).join("");
}
function launchConfetti(){
  const colors=["#ef9fbe","#9d7bc6","#79c9e7","#8bd5a8","#ffd36d"];
  for(let i=0;i<42;i++){
    const p=document.createElement("span");p.className="confetti-piece";
    p.style.left=Math.random()*100+"vw";p.style.background=colors[i%colors.length];
    p.style.setProperty("--dur",(2.8+Math.random()*2.5)+"s");
    p.style.setProperty("--rot",(Math.random()*360)+"deg");
    p.style.setProperty("--drift",(-80+Math.random()*160)+"px");
    p.style.animationDelay=(Math.random()*.8)+"s";
    document.body.appendChild(p);setTimeout(()=>p.remove(),6000);
  }
}


function showWordPreview(card,sub){
  if(!window.matchMedia("(hover:hover) and (pointer:fine)").matches && document.activeElement!==card)return;
  const tooltip=$("#wordPreviewTooltip");
  tooltip.innerHTML=`<div class="preview-head"><strong>🐭 ${escapeHtml(sub.name)}</strong><span class="preview-count">${sub.words.length}개</span></div>
    <div class="preview-word-list">${sub.words.map(w=>`<span class="preview-word"><b>${escapeHtml(w.en)}</b><small>${escapeHtml(w.ko)}</small></span>`).join("")}</div>
    <div class="preview-tip">카드를 클릭하면 이 단어 묶음이 선택돼요!</div>`;
  tooltip.classList.add("show");
  tooltip.setAttribute("aria-hidden","false");
  positionWordPreview(card);
}
function positionWordPreview(card){
  const tooltip=$("#wordPreviewTooltip");
  if(!tooltip.classList.contains("show"))return;
  const r=card.getBoundingClientRect();
  const margin=12;
  const tw=tooltip.offsetWidth||390;
  const th=tooltip.offsetHeight||320;
  let left=r.left+(r.width-tw)/2;
  left=Math.min(Math.max(margin,left),window.innerWidth-tw-margin);
  let top=r.bottom+10;
  if(top+th>window.innerHeight-margin)top=r.top-th-10;
  if(top<margin)top=margin;
  if(top+th>window.innerHeight-margin)top=window.innerHeight-th-margin;
  tooltip.style.left=`${Math.round(left)}px`;
  tooltip.style.top=`${Math.round(top)}px`;
}
function hideWordPreview(){
  const tooltip=$("#wordPreviewTooltip");
  if(!tooltip)return;
  tooltip.classList.remove("show");
  tooltip.setAttribute("aria-hidden","true");
}
function toggleFullscreen(){
  const root=document.documentElement;
  if(!document.fullscreenElement){
    const request=root.requestFullscreen||root.webkitRequestFullscreen||root.msRequestFullscreen;
    if(request)request.call(root).catch?.(()=>{});
  }else{
    const exit=document.exitFullscreen||document.webkitExitFullscreen||document.msExitFullscreen;
    if(exit)exit.call(document).catch?.(()=>{});
  }
}
function syncFullscreenButtons(){
  const on=!!document.fullscreenElement;
  $$(".fullscreen-btn").forEach(btn=>{
    btn.classList.toggle("is-fullscreen",on);
    btn.textContent=on?"🗗":"⛶";
    btn.setAttribute("aria-label",on?"전체 화면 종료":"전체 화면");
    btn.title=on?"전체 화면 종료":"전체 화면";
  });
}
function addFullscreenButtons(){
  $$(".top-nav").forEach((nav,i)=>{
    if(nav.querySelector(".fullscreen-btn"))return;
    const btn=document.createElement("button");
    btn.type="button";btn.className="icon-btn fullscreen-btn";btn.id=`fullscreenNav${i}`;
    nav.appendChild(btn);
  });
  const actions=$(".game-actions");
  if(actions && !$("#gameFullscreenBtn")){
    const btn=document.createElement("button");
    btn.type="button";btn.className="icon-btn fullscreen-btn";btn.id="gameFullscreenBtn";
    const bgm=$("#gameBgmBtn");
    bgm?actions.insertBefore(btn,bgm):actions.appendChild(btn);
  }
  const cover=$(".cover-audio");
  if(cover && !$("#introFullscreenBtn")){
    const btn=document.createElement("button");
    btn.type="button";btn.className="mini-control fullscreen-btn";btn.id="introFullscreenBtn";
    cover.appendChild(btn);
  }
  $$(".fullscreen-btn").forEach(btn=>btn.addEventListener("click",toggleFullscreen));
  syncFullscreenButtons();
}
addFullscreenButtons();
document.addEventListener("fullscreenchange",syncFullscreenButtons);
document.addEventListener("webkitfullscreenchange",syncFullscreenButtons);
window.addEventListener("resize",hideWordPreview);
window.addEventListener("scroll",hideWordPreview,true);

// Events
$("#coverStart").addEventListener("click",()=>{ensureBgm();renderCategories();showScreen("category")});
$("#coverHelp").addEventListener("click",()=>{ensureBgm();openHelp()});
$("#introBgmBtn").addEventListener("click",toggleBgm);
$$(".home-btn").forEach(b=>b.addEventListener("click",goHome));
$$(".help-btn").forEach(b=>b.addEventListener("click",openHelp));
$$(".bgm-toggle").forEach(b=>b.addEventListener("click",toggleBgm));
$("#subBackBtn").addEventListener("click",()=>showScreen("category"));
$("#settingsBackBtn").addEventListener("click",()=>showScreen("sub"));
$("#selectAllBtn").addEventListener("click",()=>{
  const cat=WORD_BANK[state.categoryIndex];
  if(state.selectedSubs.size===cat.subcategories.length)state.selectedSubs.clear();
  else state.selectedSubs=new Set(cat.subcategories.map((_,i)=>i));
  renderSubcategories();
});
$("#toSettingsBtn").addEventListener("click",()=>{updateSettingsSummary();showScreen("settings")});
$("#modeChoices").addEventListener("click",e=>{
  const b=e.target.closest("[data-mode]");if(!b)return;
  state.mode=b.dataset.mode;setChoice("#modeChoices","mode",state.mode);updateSettingsSummary();
});
$("#difficultyChoices").addEventListener("click",e=>{
  const b=e.target.closest("[data-difficulty]");if(!b)return;
  state.difficulty=b.dataset.difficulty;setChoice("#difficultyChoices","difficulty",state.difficulty);updateSettingsSummary();
});
$("#startGameBtn").addEventListener("click",startGame);
$("#gameHomeBtn").addEventListener("click",goHome);
$("#gameHelpBtn").addEventListener("click",openHelp);
$("#gameBgmBtn").addEventListener("click",toggleBgm);
$("#gameFxBtn").addEventListener("click",toggleSfx);
$("#helpCloseBtn").addEventListener("click",()=>closeHelp(true));
$("#helpModal").addEventListener("click",e=>{if(e.target===$("#helpModal"))closeHelp(true)});
$("#spellSubmitBtn").addEventListener("click",submitSpelling);
$("#spellSkipBtn").addEventListener("click",skipSpelling);
$("#spellInput").addEventListener("keydown",e=>{if(e.key==="Enter")submitSpelling()});
$("#retryBtn").addEventListener("click",startGame);
$("#reselectBtn").addEventListener("click",()=>{state.selectedSubs=new Set();renderSubcategories();showScreen("sub")});
document.addEventListener("keydown",e=>{
  if(e.key==="Escape"){
    if($("#helpModal").classList.contains("open"))closeHelp(true);
  }
});
window.addEventListener("beforeunload",e=>{
  if(state.gameActive){e.preventDefault();e.returnValue=""}
});

renderCategories();
syncAudioButtons();
</script>
</body>
</html>
